# Copy to .env and fill in. Generate passwords with: openssl rand -base64 32
# .env must never be committed.

# Postgres superuser, only used to initialise the database
POSTGRES_PASSWORD=
# Owner of the schema, used for migrations only
CASHFLOW_OWNER_PASSWORD=
# Runtime role of the backend
CASHFLOW_APP_PASSWORD=

# Encrypts the TOTP secret of the app user in the database (at least 32 characters)
TOTP_ENCRYPTION_KEY=

# Host port of the database (bound to 127.0.0.1 only)
DB_PORT=5432

# fake (generated test data) or fints (real bank)
TRANSACTION_SOURCE=fake
# PIN the fake bank accepts
FAKE_PIN=12345

# Only needed for TRANSACTION_SOURCE=fints. The PIN is never configured, it is entered in the app.
FINTS_BLZ=
FINTS_SERVER=
FINTS_LOGIN=
FINTS_PRODUCT_ID=
